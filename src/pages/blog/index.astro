---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group posts by year
const postsByYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

function readingTime(content: string): number {
  const words = content.split(/\s+/).length;
  return Math.ceil(words / 200);
}
---

<PageLayout title="Blog" description="Thoughts on data analytics, machine learning, and AI.">
  <div class="page-header">
    <h1 class="section-title">Blog</h1>
    <p class="page-desc">Thoughts on data analytics, machine learning, statistics &amp; AI.</p>
  </div>

  {posts.length === 0 ? (
    <div class="empty-state">
      <i class="fas fa-pencil-alt"></i>
      <p>No posts yet. Check back soon!</p>
    </div>
  ) : (
    years.map((year) => (
      <div class="year-group">
        <h2 class="year-label">{year}</h2>
        <div class="posts-list">
          {postsByYear[year].map((post) => {
            const rt = readingTime(post.body || '');
            const date = new Intl.DateTimeFormat('en-US', {
              month: 'short',
              day: 'numeric',
            }).format(post.data.date);
            return (
              <a href={`/blog/${post.slug}/`} class="post-card">
                <div class="post-card-date">{date}</div>
                <div class="post-card-body">
                  <h3 class="post-card-title">{post.data.title}</h3>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="post-card-tags">
                      {post.data.tags.map(tag => (
                        <span class="badge">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="post-card-meta">
                  <span><i class="fas fa-clock"></i> {rt} min</span>
                  <i class="fas fa-arrow-right"></i>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))
  )}
</PageLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .year-group {
    margin-bottom: 3rem;
  }

  .year-label {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-mono);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .year-label::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .post-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--gradient-card);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  }

  .post-card:hover {
    border-color: var(--color-border-hover);
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .post-card-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 500;
    font-family: var(--font-mono);
    min-width: 60px;
    font-variant-numeric: tabular-nums;
  }

  .post-card-body {
    flex: 1;
    min-width: 0;
  }

  .post-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: var(--transition);
  }

  .post-card:hover .post-card-title {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.8rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .post-card-meta i {
    font-size: 0.75rem;
  }

  .post-card:hover .post-card-meta .fa-arrow-right {
    color: #ffffff;
    transform: translateX(4px);
    transition: var(--transition);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .empty-state i {
    font-size: 3rem;
    color: rgba(255, 255, 255, 0.2);
    margin-bottom: 1rem;
    display: block;
  }

  @media (max-width: 600px) {
    .post-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .post-card-meta {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 0.5rem;
    }
  }
</style>
